{
  "openapi": "3.1.0",
  "info": {
    "title": "Monet Controller API",
    "version": "0.1.0",
    "description": "Local Hono controller API for the Monet desktop application."
  },
  "tags": [
    {
      "name": "System",
      "description": "Health and controller metadata endpoints."
    },
    {
      "name": "Sessions",
      "description": "Session lifecycle and history endpoints."
    },
    {
      "name": "Providers",
      "description": "Provider, model catalog, and validation endpoints."
    },
    {
      "name": "Runs",
      "description": "Run lifecycle endpoints such as interruption."
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "enum": [
              "controller"
            ],
            "example": "controller"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ]
      },
      "StopRunResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "unauthorized"
          },
          "message": {
            "type": "string",
            "example": "Missing or invalid bearer token."
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "ses_123"
          },
          "title": {
            "type": "string",
            "example": "New chat"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-23T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-23T10:05:00.000Z"
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": null
          },
          "defaultProviderId": {
            "type": [
              "string",
              "null"
            ],
            "example": "pro_b6m4q2r8t5v9x3z7k1n4p6s8"
          },
          "defaultModelId": {
            "type": [
              "string",
              "null"
            ],
            "example": "mod_c7n5r3t9w2y6k4m8p1s5v7x9"
          }
        },
        "required": [
          "id",
          "title",
          "createdAt",
          "updatedAt",
          "archivedAt",
          "defaultProviderId",
          "defaultModelId"
        ]
      },
      "ListSessionsResponse": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          }
        },
        "required": [
          "sessions"
        ]
      },
      "CreateSessionRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "SessionMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "msg_123"
          },
          "sessionId": {
            "type": "string",
            "example": "ses_123"
          },
          "runId": {
            "type": [
              "string",
              "null"
            ],
            "example": "run_123"
          },
          "role": {
            "type": "string",
            "example": "user"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-23T10:05:00.000Z"
          },
          "uiMessage": {
            "example": {
              "id": "msg_123",
              "role": "user",
              "parts": [
                {
                  "type": "text",
                  "text": "Hello"
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "sessionId",
          "runId",
          "role",
          "createdAt"
        ]
      },
      "SessionDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Session"
          },
          {
            "type": "object",
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SessionMessage"
                }
              }
            },
            "required": [
              "messages"
            ]
          }
        ]
      },
      "UpdateSessionRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "ArchiveSessionResponse": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          }
        },
        "required": [
          "session"
        ]
      },
      "Provider": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "pro_b6m4q2r8t5v9x3z7k1n4p6s8"
          },
          "type": {
            "type": "string",
            "enum": [
              "openai",
              "openrouter"
            ],
            "example": "openai"
          },
          "displayName": {
            "type": "string",
            "example": "Local Stub Provider"
          },
          "baseUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "example": null
          },
          "defaultModelName": {
            "type": [
              "string",
              "null"
            ],
            "example": "controller-echo"
          },
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "timeoutMs": {
            "type": [
              "integer",
              "null"
            ],
            "example": null
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-23T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-23T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "type",
          "displayName",
          "baseUrl",
          "defaultModelName",
          "enabled",
          "timeoutMs",
          "createdAt",
          "updatedAt"
        ]
      },
      "ListProvidersResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Provider"
            }
          }
        },
        "required": [
          "providers"
        ]
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "mod_c7n5r3t9w2y6k4m8p1s5v7x9"
          },
          "providerId": {
            "type": "string",
            "example": "pro_b6m4q2r8t5v9x3z7k1n4p6s8"
          },
          "modelName": {
            "type": "string",
            "example": "controller-echo"
          },
          "displayName": {
            "type": "string",
            "example": "Controller Echo"
          },
          "supportsTools": {
            "type": "boolean",
            "example": false
          },
          "supportsReasoning": {
            "type": "boolean",
            "example": false
          },
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "capabilitiesJson": {
            "type": [
              "string",
              "null"
            ],
            "example": null
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-23T10:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-23T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "providerId",
          "modelName",
          "displayName",
          "supportsTools",
          "supportsReasoning",
          "enabled",
          "capabilitiesJson",
          "createdAt",
          "updatedAt"
        ]
      },
      "ListModelsResponse": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        },
        "required": [
          "models"
        ]
      },
      "ValidateProviderResponse": {
        "type": "object",
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "valid": {
            "type": "boolean",
            "example": true
          },
          "reason": {
            "type": "string",
            "enum": [
              "ok",
              "disabled",
              "no_enabled_models",
              "missing_default_model",
              "default_model_unresolved",
              "missing_credentials",
              "provider_api_error"
            ],
            "example": "ok"
          },
          "message": {
            "type": "string",
            "example": "Provider configuration is valid."
          },
          "defaultModelId": {
            "type": [
              "string",
              "null"
            ],
            "example": "mod_c7n5r3t9w2y6k4m8p1s5v7x9"
          },
          "defaultModelName": {
            "type": [
              "string",
              "null"
            ],
            "example": "controller-echo"
          },
          "availableModelCount": {
            "type": "integer",
            "minimum": 0,
            "example": 1
          }
        },
        "required": [
          "provider",
          "valid",
          "reason",
          "message",
          "defaultModelId",
          "defaultModelName",
          "availableModelCount"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Report controller health",
        "description": "Returns a readiness payload for local controller orchestration.",
        "responses": {
          "200": {
            "description": "Controller is ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{runId}/stop": {
      "post": {
        "tags": [
          "Runs"
        ],
        "summary": "Stop run",
        "description": "Requests interruption of an in-flight run and marks unfinished persisted state as interrupted.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "run_123"
            },
            "required": true,
            "name": "runId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Run stop was accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StopRunResponse"
                }
              }
            }
          },
          "404": {
            "description": "The requested run was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The run could not be stopped.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "List sessions",
        "description": "Returns persisted sessions ordered by recent activity.",
        "responses": {
          "200": {
            "description": "Sessions fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSessionsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Create session",
        "description": "Creates a blank session with optional provider and model defaults.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Request body or provider/model selection is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The requested provider could not resolve a model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The session could not be created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "summary": "Get session detail",
        "description": "Returns a single session and its persisted message history.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ses_123"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Session detail fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetail"
                }
              }
            }
          },
          "404": {
            "description": "The requested session was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The session detail could not be loaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Sessions"
        ],
        "summary": "Update session",
        "description": "Updates mutable session fields such as the title.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ses_123"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The requested session was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The session could not be updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/archive": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Archive session",
        "description": "Marks a session as archived without deleting its history.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "ses_123"
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Session archived successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveSessionResponse"
                }
              }
            }
          },
          "404": {
            "description": "The requested session was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The session could not be archived.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers": {
      "get": {
        "tags": [
          "Providers"
        ],
        "summary": "List providers",
        "description": "Returns persisted providers ordered by enabled status and name.",
        "responses": {
          "200": {
            "description": "Providers fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": [
          "Providers"
        ],
        "summary": "List models",
        "description": "Returns all persisted provider models ordered by enabled status and provider.",
        "responses": {
          "200": {
            "description": "Models fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/{providerId}/models": {
      "get": {
        "tags": [
          "Providers"
        ],
        "summary": "List models for provider",
        "description": "Returns persisted models for a single provider.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "pro_b6m4q2r8t5v9x3z7k1n4p6s8"
            },
            "required": true,
            "name": "providerId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Provider models fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListModelsResponse"
                }
              }
            }
          },
          "404": {
            "description": "The requested provider was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The provider models could not be loaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/{providerId}/validate": {
      "post": {
        "tags": [
          "Providers"
        ],
        "summary": "Validate provider",
        "description": "Validates a persisted provider against current local configuration and enabled models.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "pro_b6m4q2r8t5v9x3z7k1n4p6s8"
            },
            "required": true,
            "name": "providerId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Provider validation completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateProviderResponse"
                }
              }
            }
          },
          "404": {
            "description": "The requested provider was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "The provider validation could not be completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
